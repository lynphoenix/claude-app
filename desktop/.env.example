# Desktop Client Configuration

# Server Connection
SERVER_URL=ws://47.99.75.219:3001/ws
DEVICE_ID=desktop-macbook

# Device Display Name (shown to users, e.g., "Mac", "H100", "219")
DEVICE_DISPLAY_NAME=Mac

# Claude Code Path (optional, defaults to 'claude' in PATH)
# CLAUDE_PATH=/Users/username/.local/bin/claude

# Working Directory (optional, defaults to current directory)
# WORK_DIR=/Users/username/projects

# Database (for session history sync)
DB_HOST=47.99.75.219
DB_PORT=5432
DB_NAME=claude_mobile
DB_USER=postgres
DB_PASSWORD=your_password

# Encryption (E2E encryption keys)
# Will be generated on first run if not provided
# ENCRYPTION_PRIVATE_KEY=
# ENCRYPTION_PUBLIC_KEY=
