# 服务器配置
PORT=3001

# 默认项目路径
DEFAULT_PROJECT_PATH=/home/user/projects/default

# 允许访问的项目目录列表（逗号分隔）
# 客户端只能切换到这些目录
ALLOWED_PROJECTS=/home/user/projects/project1,/home/user/projects/project2,/home/user/projects/project3

# CORS 配置（允许访问的域名）
CORS_ORIGIN=*

# API 密钥（可选，用于验证客户端）
# API_KEY=your-api-key-here
